rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Mirrors Constants.SUPER_ADMIN_EMAILS in the app. Only these emails may
    // self-elevate to superadmin/approved on their very first sign-in; every
    // other email can only self-create a pending, role="user" profile.
    function isBootstrapSuperAdmin(email) {
      return email in ['ashisha340d@gmail.com'];
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email));
    }
    function haveProfile() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }
    function isApprovedMember(stationId) {
      return haveProfile() && myProfile().data.status == 'approved'
        && stationId in myProfile().data.stations;
    }
    function isAdmin() {
      return haveProfile() && myProfile().data.status == 'approved'
        && myProfile().data.role in ['admin', 'superadmin'];
    }
    function isSuperAdmin() {
      return haveProfile() && myProfile().data.status == 'approved'
        && myProfile().data.role == 'superadmin';
    }

    match /users/{email} {
      // You can read your own profile (needed for onboarding checks);
      // admins/super admins can read any profile to manage approvals.
      allow get: if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow list: if isAdmin();

      allow create: if request.auth != null && (
        (
          request.auth.token.email == email &&
          (
            (isBootstrapSuperAdmin(email) &&
              request.resource.data.status == 'approved' &&
              request.resource.data.role == 'superadmin') ||
            (!isBootstrapSuperAdmin(email) &&
              request.resource.data.status == 'pending' &&
              request.resource.data.role == 'user')
          )
        ) ||
        isAdmin()
      );

      // You may only ever change your own pinHash. Admins can change
      // anything on anyone (approvals, role, station assignment).
      allow update: if request.auth != null && (
        (request.auth.token.email == email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinHash'])) ||
        isAdmin()
      );

      allow delete: if false;
    }

    match /stations/{stationId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();

      match /orders/{orderId} {
        allow read: if isApprovedMember(stationId);
        allow create: if isApprovedMember(stationId);
        allow delete: if isApprovedMember(stationId);

        // Any assigned member can edit order details/items/acknowledge/
        // voice note; only an admin may mark an order done.
        allow update: if isApprovedMember(stationId) && (
          isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['eventType', 'location', 'contactName', 'pax', 'orderTimeMillis',
             'items', 'acknowledgedBy', 'voiceNoteUrl']
          )
        );
      }
    }
  }
}
