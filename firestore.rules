rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /groups/{groupId} {
      // Anyone signed in can fetch a group by its exact code (needed to join).
      allow get: if request.auth != null;

      // "My groups" query only ever returns groups you're already in.
      allow list: if request.auth != null
        && request.auth.token.email in resource.data.members;

      // Creating a group: you become its sole member and admin.
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.token.email]
        && request.resource.data.admins == [request.auth.token.email];

      // Existing members can edit the group; a non-member may only add
      // themselves to "members" (joining via code) and nothing else.
      allow update: if request.auth != null && (
        request.auth.token.email in resource.data.members ||
        (
          request.resource.data.members == resource.data.members.concat([request.auth.token.email]) &&
          request.resource.data.admins == resource.data.admins &&
          request.resource.data.name == resource.data.name
        )
      );

      allow delete: if false;

      match /orders/{orderId} {
        function isMember() {
          return request.auth != null &&
            request.auth.token.email in
              get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        }
        function isAdmin() {
          return request.auth != null &&
            request.auth.token.email in
              get(/databases/$(database)/documents/groups/$(groupId)).data.admins;
        }

        allow read: if isMember();
        allow create: if isMember();
        allow delete: if isMember();

        // Any member can edit order details, items or acknowledge; only an
        // admin may change served/servedBy (marking an order as served).
        allow update: if isMember() && (
          isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ["eventType", "location", "contactName", "pax", "orderTimeMillis", "items", "acknowledgedBy"]
          )
        );
      }
    }
  }
}
